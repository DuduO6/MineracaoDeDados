YOUTUBE_API_KEY=YOUR_API_KEY_HERE
# Alternativa OAuth para credenciais de aplicativo instalado:
# YOUTUBE_CLIENT_SECRETS=secrets.json
# YOUTUBE_TOKEN_FILE=token.json
# PRE_GAME_DAYS=3
# POST_GAME_DAYS=3
# MATCH_DURATION_MINUTES=120
# MAX_PRE_GAME_VIDEOS_PER_MATCH=5
# MAX_POST_GAME_VIDEOS_PER_MATCH=5
# MAX_COMMENTS_PER_VIDEO=
# ANONYMIZE_USERS=true
# Use um valor secreto e estável em uma nova coleta destinada à publicação.
# ANONYMIZATION_SALT=change-me
# REQUEST_TIMEOUT=30
# REQUEST_RETRIES=4
